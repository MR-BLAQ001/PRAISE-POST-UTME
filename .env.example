# ---------------------------------------------------------------------------
# PRAISE POST UTME — environment variables
# Copy this file to .env.local and fill in what you need.
# The app works fully in local demo mode with NO variables configured.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (optional — required for production accounts & online leaderboard)
# Create a project at https://supabase.com, then copy the values below.
# NEVER put the service-role key in NEXT_PUBLIC_* variables, and never commit
# a filled .env.local file to GitHub.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by trusted server jobs / admin scripts. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for a hosted data adapter. This build ships with the complete local
# demo store; the Supabase schema is provided as a production path but is not
# wired into the UI yet. Keep this false until you implement and test an
# adapter that reads/writes the tables in supabase/schema.sql.
NEXT_PUBLIC_USE_SUPABASE=false
